{
  "manifest_version": 3,
  "name": "History Guard Pro",
  "version": "3.0.2",
  "description": "Privacy control center: tự động dọn lịch sử, bảo vệ khôi phục, Smart Rules, Restore Center.",
  "permissions": [
    "history",
    "tabs",
    "storage",
    "webNavigation",
    "alarms",
    "sessions",
    "browsingData",
    "contextMenus"
  ],
  "background": {
    "service_worker": "src/service-worker.js"
  },
  "action": {
    "default_title": "History Guard Pro",
    "default_popup": "popup/popup.html"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "commands": {
    "wipe-now": {
      "suggested_key": {
        "default": "Alt+Shift+H"
      },
      "description": "History Guard Pro — Wipe Now"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
